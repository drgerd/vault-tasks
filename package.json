{
  "name": "@gerd/vault-tasks",
  "version": "0.1.1",
  "private": false,
  "description": "Portable CLI for structured queries over Obsidian Tasks Markdown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drgerd/vault-tasks.git"
  },
  "bugs": {
    "url": "https://github.com/drgerd/vault-tasks/issues"
  },
  "homepage": "https://github.com/drgerd/vault-tasks#readme",
  "keywords": [
    "obsidian",
    "tasks",
    "cli",
    "markdown"
  ],
  "type": "module",
  "bin": {
    "vault-tasks": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "config/vault-tasks.schema.json",
    "config/vault-tasks.example.json",
    "config/vault-tasks.local.example.json",
    "docs",
    "agent-skill",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
